@model PersonelIzinSistemi.Models.Personel

@{
    var editing = Model.Id > 0;
    ViewData["Title"] = editing ? "Personel Düzenle" : "Yeni Personel";
}

<div class="page-heading">
    <div>
        <div class="eyebrow">EKİP YÖNETİMİ</div>
        <h1>@ViewData["Title"]</h1>
        <p>Personel bilgilerini eksiksiz doldurun.</p>
    </div>
    <a class="btn btn-secondary" asp-action="Index">← Listeye dön</a>
</div>

<div class="panel form-panel">
    <div class="panel-heading">
        <div>
            <h2>Personel Bilgileri</h2>
            <p>Kaydettiğiniz bilgiler SQL Server'a yazılacaktır.</p>
        </div>
    </div>

    <form method="post" asp-action="@(editing ? "Edit" : "Create")" asp-route-id="@(editing ? Model.Id : null)" class="person-form">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <div asp-validation-summary="ModelOnly" class="validation"></div>

        <div class="form-grid">
            <label>
                Ad
                <input asp-for="Ad" maxlength="50" required placeholder="Örn. Ahmet" />
                <span asp-validation-for="Ad" class="validation"></span>
            </label>
            <label>
                Soyad
                <input asp-for="Soyad" maxlength="50" required placeholder="Örn. Yılmaz" />
                <span asp-validation-for="Soyad" class="validation"></span>
            </label>
            <label>
                Departman
                <input asp-for="Departman" maxlength="50" required placeholder="Örn. Yazılım" />
                <span asp-validation-for="Departman" class="validation"></span>
            </label>
            <label>
                Maaş (₺)
                <input asp-for="Maas" type="number" step="0.01" min="0" max="99999999" required />
                <span asp-validation-for="Maas" class="validation"></span>
            </label>
        </div>

        <div class="form-actions">
            <a class="btn btn-secondary" asp-action="Index">İptal</a>
            <button type="submit" class="btn btn-primary">@(editing ? "Değişiklikleri Kaydet" : "Personel Oluştur")</button>
        </div>
    </form>
</div>
